{
  "description": "Check files Claude writes for Arabic/RTL + English ordering problems",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bidi_hook.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
